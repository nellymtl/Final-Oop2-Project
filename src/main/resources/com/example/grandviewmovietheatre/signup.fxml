<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="900.0" prefWidth="700.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.grandviewmovietheatre.SignupViewController">

    <VBox alignment="TOP_CENTER" spacing="25" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">

        <!-- Cinema Name -->
        <Label styleClass="cinema-title" text="GRANDVIEW" />

        <HBox alignment="CENTER" spacing="15">
            <Separator prefWidth="90" />
            <Label styleClass="cinema-subtitle" text="MOVIE THEATRE" />
            <Separator prefWidth="90" />
        </HBox>

        <!-- Signup Card -->
        <VBox maxWidth="600" spacing="20" styleClass="register-card">

            <padding>
                <Insets bottom="35" left="40" right="40" top="35" />
            </padding>

            <Label styleClass="register-title" text="Create Customer Account">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>

            <VBox spacing="8">
                <Label styleClass="field-label" text="Name">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
                <TextField fx:id="nameField" promptText="Enter your name" styleClass="custom-field" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="field-label" text="Email">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
                <TextField fx:id="emailField" promptText="Enter your email" styleClass="custom-field" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="field-label" text="Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="custom-field" />
            </VBox>

            <Button fx:id="createAccountButton" maxWidth="Infinity" prefHeight="60" styleClass="create-button" text="Create Account" />

            <HBox alignment="CENTER" spacing="5">
                <Label styleClass="normal-text" text="Already have an account?" />

                <Hyperlink fx:id="loginLink" styleClass="login-link" text="Log In" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>
