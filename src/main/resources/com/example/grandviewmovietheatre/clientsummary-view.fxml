<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ClientSummaryViewController"
            prefWidth="540" prefHeight="440">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <top>
        <VBox spacing="4">
            <Label text="Order Summary" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Grand View Movie Theatre — Review your movie tickets and total"
                   style="-fx-text-fill: #555555;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="18" bottom="18"/>
            </padding>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="38"/>
                    <ColumnConstraints percentWidth="62"/>
                </columnConstraints>

                <Label text="Movie:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="movieTitleLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Screening Room:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="roomLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Showtime:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="showtimeLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Ticket Price:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="unitPriceLabel" text="0.00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Number of Tickets:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
                    <Spinner fx:id="ticketQuantitySpinner" editable="true" prefWidth="95"/>
                    <Label fx:id="availableSeatsLabel" text="" style="-fx-text-fill: #666666;"/>
                </HBox>

                <Label text="Subtotal:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label fx:id="subtotalLabel" text="0.00" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Taxes:" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Label fx:id="taxLabel" text="0.00" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Total Amount:" style="-fx-font-size: 15px; -fx-font-weight: bold;"
                       GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <Label fx:id="totalAmountLabel" text="0.00"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;"
                       GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #c62828;"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back" onAction="#handleBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="proceedButton" text="Proceed to Payment" defaultButton="true"
                    onAction="#handleProceedToPayment"/>
        </HBox>
    </bottom>
</BorderPane>