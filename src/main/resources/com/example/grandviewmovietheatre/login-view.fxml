<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="900.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <VBox alignment="TOP_CENTER" spacing="25" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">

        <!-- Cinema Name -->
        <VBox alignment="CENTER" spacing="5">
            <Label styleClass="cinema-title" text="GRANDVIEW" />

            <HBox alignment="CENTER" spacing="15">
                <Separator prefWidth="80" />
                <Label styleClass="cinema-subtitle" text="MOVIE THEATRE" />
                <Separator prefWidth="80" />
            </HBox>
        </VBox>

        <!-- Login Card -->
        <VBox alignment="TOP_CENTER" maxWidth="560" spacing="20" styleClass="login-card">

            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>

            <Label styleClass="login-title" text="Log In">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>

            <Label styleClass="access-label" text="Customer and Manager Access">
            <font>
               <Font name="System Bold Italic" size="12.0" />
            </font></Label>

            <!-- Username -->
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="field-label" text="Email or Username">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>

                <TextField fx:id="usernameField" promptText="Enter your email or username" styleClass="custom-field" />
            </VBox>

            <!-- Password -->
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="field-label" text="Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>

                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="custom-field" />
            </VBox>

            <!-- Login Button -->
            <Button maxWidth="Infinity" prefHeight="0.0" prefWidth="270.0" styleClass="login-button" text="Log In" />

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" />
                <Label styleClass="divider-text" text="New customer?" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Register Button -->
            <Button maxWidth="Infinity" prefHeight="0.0" prefWidth="420.0" styleClass="register-button" text="Create Customer Account" />

            <Label styleClass="manager-label" text="Managers: use your provided credentials." />

        </VBox>

    </VBox>

</AnchorPane>
