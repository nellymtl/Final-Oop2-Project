<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.grandviewmovietheatre.BrowserViewController"
            styleClass="root-pane">

    <VBox alignment="TOP_CENTER"
          spacing="25"
          AnchorPane.topAnchor="30.0"
          AnchorPane.bottomAnchor="30.0"
          AnchorPane.leftAnchor="30.0"
          AnchorPane.rightAnchor="30.0">

        <!-- Cinema Name -->
        <Label text="GRANDVIEW"
               styleClass="cinema-title"/>

        <Label text="MOVIE THEATRE"
               styleClass="cinema-subtitle"/>

        <!-- Browse Card -->
        <VBox alignment="CENTER"
              spacing="20"
              prefWidth="650"
              maxWidth="650"
              styleClass="register-card">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <Label text="Browse Movies"
                   styleClass="register-title"/>

            <ListView fx:id="moviesListView"
                      prefWidth="550"
                      prefHeight="450"
                      VBox.vgrow="ALWAYS"/>

            <Button text="Select"
                    fx:id="selectButton"
                    onAction="#handleSelectMovie"
                    prefHeight="60"
                    maxWidth="Infinity"
                    styleClass="create-button"/>

        </VBox>

    </VBox>

</AnchorPane>