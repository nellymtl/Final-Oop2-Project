<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.grandviewmovietheatre.BrowserViewController">

    <VBox alignment="TOP_CENTER" spacing="25" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

        <!-- Cinema Name -->
        <Label styleClass="cinema-title" text="GRANDVIEW">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>

        <Label styleClass="cinema-subtitle" text="MOVIE THEATRE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>

        <!-- Browse Card -->
        <VBox alignment="CENTER" maxWidth="650" prefWidth="650" spacing="20" styleClass="register-card">

            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <Label styleClass="register-title" text="Browse Movies">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Label>

            <ListView fx:id="moviesListView" prefHeight="450" prefWidth="550" VBox.vgrow="ALWAYS" />

            <Button fx:id="selectButton" maxWidth="Infinity" onAction="#handleSelectMovie" prefHeight="60" styleClass="create-button" text="Select" />

        </VBox>

    </VBox>

</AnchorPane>
