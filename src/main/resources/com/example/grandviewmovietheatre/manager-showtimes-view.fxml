<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ManagerShowtimesViewController"
            prefWidth="700" prefHeight="450">

    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Manage Showtimes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Display, add, modify, or delete upcoming movie showtimes"
                       style="-fx-text-fill: #555555;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="Back to Menu" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="16" bottom="10"/>
            </padding>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Upcoming Showtimes" style="-fx-font-weight: bold;"/>
                <ListView fx:id="showtimeListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="10" prefWidth="290">
                <Label text="Showtime Details" style="-fx-font-weight: bold;"/>
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="65"/>
                    </columnConstraints>

                    <Label text="Movie:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="showtimeMovieCombo" maxWidth="Infinity"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Room:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="showtimeRoomCombo" maxWidth="Infinity"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Date/Time:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="showtimeDateTimeField" promptText="YYYY-MM-DD HH:mm"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="8">
                    <Button text="Add" onAction="#handleAddShowtime"/>
                    <Button text="Modify" onAction="#handleUpdateShowtime"/>
                    <Button text="Delete" onAction="#handleDeleteShowtime"/>
                    <Button text="Clear" onAction="#handleClearForm"/>
                </HBox>

                <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #2e7d32;"/>
                <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #c62828;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
